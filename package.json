{
  "name": "agent-war-room",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "bindings": "cargo test -p awr-application export_bindings",
    "bridge": "cargo build -p warroom-hook",
    "tauri": "tauri",
    "app": "npm run bridge && tauri dev",
    "test": "vitest run",
    "sidecar": "node scripts/sidecar.mjs",
    "package": "npm run sidecar && tauri build --config src-tauri/tauri.bundle.conf.json",
    "shot": "npm run build --silent && node scripts/shot.mjs",
    "check": "bash scripts/check.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
